---
interface Props {
  href?: string;
  class?: string;
  variant?: "primary" | "outline" | "ghost";
}

const { href, class: className, variant = "primary" } = Astro.props;

const baseStyles =
  "inline-flex items-center justify-center px-6 py-3 min-h-[44px] text-sm md:text-base font-bold transition-all duration-300 rounded-xl active:scale-95 shadow-sm select-none touch-manipulation";

const variants = {
  primary:
    "bg-slate-900 text-white hover:bg-slate-800 dark:bg-blue-600 dark:hover:bg-blue-500 border border-transparent dark:border-blue-400/20 shadow-blue-900/10",
  outline:
    "bg-transparent border-2 border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white hover:bg-slate-50 dark:hover:bg-slate-800",
  ghost:
    "bg-transparent text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 shadow-none",
};

const styles = `${baseStyles} ${variants[variant]} ${className || ""}`;
---

{
  href ? (
    <a href={href} class={styles}>
      <slot />
    </a>
  ) : (
    <button class={styles}>
      <slot />
    </button>
  )
}
