---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import { getNews } from "../../lib/newsService";
import { SOURCES, type Category } from "../../config/newsConfig";
import NewCard from "../../components/new/NewCard.astro";
import Button from "../../components/ui/Button.astro";

export async function getStaticPaths() {
  const categorias = Object.keys(SOURCES);
  return categorias.map((cat) => ({
    params: { categoria: cat },
  }));
}

const { categoria } = Astro.params;
const selectedCategory =
  categoria && categoria in SOURCES ? (categoria as Category) : undefined;
const news = getNews(selectedCategory);

const categoryMap: Record<
  string,
  { label: string; desc: string; intro: string[] }
> = {
  general: {
    label: "General",
    desc: "La actualidad de Colombia y el mundo en un solo lugar.",
    intro: [
      "En BrayNews reunimos cada día las noticias más relevantes de Colombia y del mundo para que te pongas al día en minutos. Nuestro equipo selecciona los temas que de verdad importan y te ofrece un resumen claro y directo de cada historia.",
      "Aquí encuentras el pulso de la actualidad nacional e internacional: política, sociedad, clima, cultura y todo lo que está moviendo la conversación en el planeta, con la mirada puesta siempre desde Montería y Córdoba.",
    ],
  },
  tecnologia: {
    label: "Tecnología",
    desc: "Gadgets, IA y el futuro digital.",
    intro: [
      "La tecnología avanza demasiado rápido para quedarse atrás. En esta sección cubrimos inteligencia artificial, nuevos dispositivos, software y las tendencias digitales que están cambiando nuestra forma de vivir y trabajar.",
      "Explicamos en lenguaje sencillo lo que significan los lanzamientos y avances más importantes, para que estés informado sin necesidad de ser un experto en el tema.",
    ],
  },
  deportes: {
    label: "Deportes",
    desc: "Resultados y toda la pasión del deporte mundial.",
    intro: [
      "Del fútbol colombiano a las grandes ligas del mundo, aquí sigues el resultado de cada jornada, los fichajes, las polémicas y las historias detrás de los atletas.",
      "Te traemos lo esencial del deporte nacional e internacional con análisis que van más allá del marcador.",
    ],
  },
  politica: {
    label: "Política",
    desc: "Análisis y actualidad del panorama político.",
    intro: [
      "La política define el rumbo del país y tu día a día. Cubrimos las decisiones del Gobierno, el Congreso y los temas que marcan la agenda nacional y regional.",
      "Nuestro objetivo es ofrecerte información clara, equilibrada y con contexto, para que puedas formarte tu propia opinión con datos sólidos.",
    ],
  },
  finanzas: {
    label: "Finanzas",
    desc: "Economía, mercados y el pulso del dinero.",
    intro: [
      "El precio del dólar, la inflación, las tasas de interés y los negocios que mueven la economía colombiana: aquí lo resumimos de forma sencilla y práctica.",
      "Sigue la actualidad económica para tomar mejores decisiones con tu dinero y entender qué significa cada cifra para tu bolsillo.",
    ],
  },
  local: {
    label: "Montería y Córdoba",
    desc: "Lo que pasa en nuestra tierra, minuto a minuto.",
    intro: [
      "Esta es nuestra casa. Reunimos las noticias de Montería y todo Córdoba: obras, eventos, seguridad, cultura y las historias de nuestra gente.",
      "Creemos que lo local importa tanto como lo nacional, por eso le damos un espacio propio a todo lo que está pasando en nuestra región.",
    ],
  },
};

const currentInfo = categoryMap[categoria as string] || {
  label: categoria
    ? categoria.charAt(0).toUpperCase() + categoria.slice(1)
    : "General",
  desc: "Noticias actualizadas minuto a minuto.",
  intro: [],
};
---

<Layout
  title={`${currentInfo.label} | BrayNews`}
  description={currentInfo.desc}
>
  <main class="max-w-7xl mx-auto px-4 py-10">
    <!-- HEADER DE CATEGORÍA -->
    <header class="mb-12 border-l-8 border-blue-600 pl-6 py-2">
      <nav
        class="text-[10px] font-black text-blue-600 dark:text-blue-400 uppercase tracking-[0.2em] mb-3"
      >
        <a
          href="/"
          class="hover:text-slate-900 dark:hover:text-white transition"
          >Inicio</a
        >
        <span class="mx-2 text-slate-500 dark:text-slate-400">/</span>
        <span class="text-slate-600 dark:text-slate-400">Categoría</span>
      </nav>
      <h1
        class="text-5xl md:text-7xl font-black text-slate-900 dark:text-white uppercase tracking-tighter leading-none"
      >
        {currentInfo.label}
      </h1>
      <p
        class="text-lg md:text-xl text-slate-500 dark:text-slate-400 mt-4 max-w-2xl font-medium leading-relaxed"
      >
        {currentInfo.desc}
      </p>
      {currentInfo.intro.length > 0 && (
        <div
          class="mt-6 max-w-3xl space-y-3 text-sm md:text-base text-slate-500 dark:text-slate-400 leading-relaxed"
        >
          {currentInfo.intro.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
      )}
    </header>

    <!-- GRID DE NOTICIAS: 1 col móvil, 2 tablet, 3 PC -->
    {
      news.length > 0 ? (
        <section class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {news.map((noticia) => (
            <NewCard noticia={noticia} headingLevel="h2" />
          ))}
        </section>
      ) : (
        /* EMPTY STATE */
        <section class="flex flex-col items-center justify-center py-32 text-center bg-white dark:bg-[#131B2E]/60 rounded-[40px] border border-dashed border-slate-200 dark:border-slate-800/80 px-6">
          <div class="text-7xl mb-6 animate-pulse">🗞️</div>
          <h2 class="text-3xl font-black text-slate-800 dark:text-slate-200 uppercase tracking-tighter">
            Sin noticias en esta sección
          </h2>
          <p class="text-slate-500 mt-4 mb-10">
            Estamos actualizando las fuentes para traerte lo mejor.
          </p>
          <Button href="/">VOLVER AL INICIO</Button>
        </section>
      )
    }
  </main>
</Layout>
