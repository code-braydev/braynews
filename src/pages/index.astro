---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import NewsCard from "../components/new/NewCard.astro";
import { getAllNews } from "../lib/newsService";

const todasLasNoticias = getAllNews();

const [noticiaPrincipal, ...otrasNoticias] = todasLasNoticias;
---

<Layout
  title="BrayNews - Noticias de Montería, Córdoba y el Mundo | Actualidad de BrayDev"
  description="BrayNews: Tu portal de noticias inteligente. Lee lo último sobre tecnología, deportes, política, finanzas y noticias locales de Montería y Córdoba."
  keywords="BrayNews, noticias Montería, noticias Córdoba, noticias Colombia, portal de noticias, actualidad en tiempo real, noticias de BrayDev, tecnología, deportes, política, finanzas"
>
  <main class="max-w-7xl mx-auto px-4 py-8">
    <header class="mb-12">
      <h1
        id="home-heading"
        class="text-4xl font-black text-slate-900 dark:text-white uppercase tracking-tighter"
      >
        Últimas Noticias
      </h1>
      <p id="home-sub" class="text-slate-600 dark:text-slate-400 font-medium">
        La actualidad de Montería y el mundo en un solo lugar.
      </p>
    </header>

    {
      noticiaPrincipal && (
        <section class="mb-16">
          <NewsCard noticia={noticiaPrincipal} variant="featured" headingLevel="h2" />
        </section>
      )
    }
    <section>
      <div class="flex items-center gap-4 mb-8">
        <h2
          class="text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tighter"
        >
          Más para leer
        </h2>
        <div class="h-px bg-slate-200 dark:bg-slate-800 grow"></div>
      </div>

      <div id="news-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {otrasNoticias.slice(0, 12).map((n) => <NewsCard noticia={n} />)}
      </div>
    </section>
  </main>
</Layout>

<script is:inline>
  const CAT_LABELS = {
    tecnologia: "Tecnología",
    deportes: "Deportes",
    politica: "Política",
    finanzas: "Finanzas",
    local: "Montería y Córdoba",
    general: "General",
  };

  const grid = document.getElementById("news-grid");

  if (grid && grid.children.length > 0) {
    let interests = {};
    try {
      interests = JSON.parse(localStorage.getItem("user_interests") || "{}");
    } catch {
      interests = {};
    }

    const cookiePref = document.cookie
      .split("; ")
      .find((row) => row.startsWith("pref_category="))
      ?.split("=")[1];

    if (cookiePref && !interests[cookiePref]) {
      interests[cookiePref] = 1;
    }

    const ranked = Object.keys(interests).sort(
      (a, b) => interests[b] - interests[a],
    );

    if (ranked.length > 0) {
      const cards = Array.from(grid.children);

      cards.sort((a, b) => {
        const ia = ranked.indexOf(a.getAttribute("data-category"));
        const ib = ranked.indexOf(b.getAttribute("data-category"));
        return (ia === -1 ? ranked.length : ia) - (ib === -1 ? ranked.length : ib);
      });

      cards.forEach((card) => grid.appendChild(card));

      const top = ranked[0];
      const label = CAT_LABELS[top] || top;
      const heading = document.getElementById("home-heading");
      const sub = document.getElementById("home-sub");

      if (heading) heading.textContent = `Noticias para ti: ${label}`;
      if (sub) {
        sub.textContent = `Basado en tu interés por ${label}, hemos actualizado tu portada.`;
      }
    }
  }
</script>
