---
import Layout from "../layouts/Layout.astro";
import NewsCard from "../components/new/NewCard.astro";
import { getNews } from "../lib/newsService";

// 1. Leemos la preferencia del usuario desde la cookie
const userPreference = Astro.cookies.get("pref_category")?.value;

// 2. Traemos todas las noticias (o de todas las categorías)
const todasLasNoticias = await getNews();

// 3. Algoritmo de Personalización del Inicio
let noticiasOrdenadas = [...todasLasNoticias];

if (userPreference) {
  noticiasOrdenadas = todasLasNoticias.sort((a, b) => {
    // Si la noticia es de la categoría preferida, le damos prioridad
    const isAPreferred = a.category === userPreference;
    const isBPreferred = b.category === userPreference;

    if (isAPreferred && !isBPreferred) return -1;
    if (!isAPreferred && isBPreferred) return 1;

    // Si ambas son de la misma categoría (o ninguna lo es),
    // mantenemos el orden por fecha (el más reciente primero)
    return new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime();
  });
}

// Separamos la principal (Featured) de las demás
const [noticiaPrincipal, ...otrasNoticias] = noticiasOrdenadas;

// 3. Separamos por categorías para las secciones
const locales = otrasNoticias.filter((n) => n.category === "local").slice(0, 4);
const tecnologia = otrasNoticias
  .filter((n) => n.category === "tecnologia")
  .slice(0, 4);
const masNoticias = otrasNoticias.slice(4, 16);
const destacada = noticiaPrincipal;
---

<Layout
  title="BrayNews - Noticias de Montería, Córdoba y el Mundo | Actualidad de BrayDev"
  description="BrayNews: Tu portal de noticias inteligente. Lee lo último sobre tecnología, deportes, política, finanzas y noticias locales de Montería y Córdoba."
  keywords="BrayNews, noticias Montería, noticias Córdoba, noticias Colombia, portal de noticias, actualidad en tiempo real, noticias de BrayDev, tecnología, deportes, política, finanzas"
>
  <main class="max-w-7xl mx-auto px-4 py-8">
    <!-- Título dinámico para dar esa sensación de "Familiaridad" -->
    <header class="mb-12">
      <h1
        class="text-4xl font-black text-slate-900 dark:text-white uppercase tracking-tighter"
      >
        {
          userPreference
            ? `Noticias para ti: ${userPreference}`
            : "Últimas Noticias"
        }
      </h1>
      <p class="text-slate-500 dark:text-slate-400 font-medium">
        {
          userPreference
            ? `Basado en tu interés por ${userPreference}, hemos actualizado tu portada.`
            : "La actualidad de Montería y el mundo en un solo lugar."
        }
      </p>
    </header>

    {
      noticiaPrincipal && (
        <section class="mb-16">
          <NewsCard noticia={noticiaPrincipal} variant="featured" />
        </section>
      )
    }

    <!-- El resto de la parrilla organizada -->
    <section>
      <div class="flex items-center gap-4 mb-8">
        <h2
          class="text-2xl font-black text-slate-900 dark:text-white uppercase tracking-tighter"
        >
          Más para leer
        </h2>
        <div class="h-px bg-slate-200 dark:bg-slate-800 grow"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {otrasNoticias.slice(0, 12).map((n) => <NewsCard noticia={n} />)}
      </div>
    </section>
  </main>
</Layout>
