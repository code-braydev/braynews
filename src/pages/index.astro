---
import { getNews } from "../lib/newsService";
import Layout from "../layouts/Layout.astro";
import Card from "../components/new/Card.astro";
import Button from "../components/ui/Button.astro";

const allNews = await getNews();

const destacada = allNews[0];
const tecnologia = allNews
  .filter((n) => n.category === "tecnologia")
  .slice(0, 3);
const locales = allNews.filter((n) => n.category === "local").slice(0, 4);
const masNoticias = allNews.length > 1 ? allNews.slice(1, 13) : [];
---

<Layout title="BrayNews | El Portal de Montería">
  <main class="max-w-7xl mx-auto px-4 py-6 md:py-10 space-y-16 md:space-y-20">
    {
      destacada ? (
        <section class="animate-fade-in">
          <div class="flex items-center gap-2 border-b border-slate-200 dark:border-slate-800 pb-4 mb-8">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-400 opacity-75" />
              <span class="relative inline-flex rounded-full h-3 w-3 bg-blue-600" />
            </span>
            <h2 class="text-sm font-black uppercase tracking-[0.2em] text-blue-600 dark:text-blue-400">
              Lo Último de Hoy
            </h2>
          </div>
          <Card noticia={destacada} variant="featured" />
        </section>
      ) : (
        <div class="text-center py-20 text-slate-400">
          Buscando noticias frescas...
        </div>
      )
    }

    <div
      class="md:hidden w-full bg-slate-50 dark:bg-slate-900/50 border-2 border-dashed border-slate-200 dark:border-slate-800 rounded-3xl p-6 flex flex-col items-center justify-center min-h-[150px]"
    >
      <span
        class="text-[8px] font-black text-slate-400 uppercase tracking-widest mb-2"
        >Publicidad</span
      >
      <div class="text-[10px] text-slate-500 italic">
        Espacio para anuncio nativo
      </div>
    </div>

    <section
      class="bg-slate-100 dark:bg-slate-900/50 -mx-4 px-4 py-16 sm:rounded-[40px] transition-colors duration-300"
    >
      <div class="max-w-7xl mx-auto">
        <div
          class="flex flex-col md:flex-row justify-between items-start md:items-end mb-10 gap-6"
        >
          <div>
            <h2
              class="text-4xl md:text-5xl font-black text-slate-900 dark:text-white tracking-tighter"
            >
              Córdoba Al Día
            </h2>
            <p
              class="text-lg text-slate-500 dark:text-slate-400 font-medium mt-2"
            >
              Montería y el departamento en tiempo real
            </p>
          </div>
          <Button href="/categoria/local" class="group">
            Ver todo Córdoba
            <span class="ml-2 group-hover:translate-x-1 transition-transform"
              >→</span
            >
          </Button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {
            locales.length > 0 ? (
              locales.map((n) => <Card noticia={n} />)
            ) : (
              <p class="text-slate-500 italic col-span-full text-center py-10">
                No hay noticias locales.
              </p>
            )
          }
        </div>
      </div>
    </section>

    <div class="flex flex-col lg:flex-row gap-12 xl:gap-16">
      <div class="lg:w-3/4 space-y-12">
        <section>
          <div
            class="flex justify-between items-end mb-10 border-l-8 border-blue-600 pl-6 py-1"
          >
            <div>
              <h2
                class="text-3xl font-black text-slate-900 dark:text-white tracking-tight uppercase"
              >
                Mundo Tech
              </h2>
              <p class="text-slate-500 dark:text-slate-400 text-sm font-bold">
                Gadgets e IA
              </p>
            </div>
            <Button
              href="/categoria/tecnologia"
              variant="ghost"
              class="text-blue-600 dark:text-blue-400"
            >
              Más tecnología →
            </Button>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {tecnologia.map((n) => <Card noticia={n} />)}
          </div>
        </section>

        <section class="border-t border-slate-200 dark:border-slate-800 pt-16">
          <h2
            class="text-2xl font-black text-slate-900 dark:text-white mb-10 uppercase tracking-tighter"
          >
            Otras Noticias
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {
              masNoticias.map((n, index) => (
                <>
                  <Card noticia={n} />
                  {/* Anuncio móvil cada 4 noticias */}
                  {(index + 1) % 4 === 0 && (
                    <div class="md:hidden col-span-1 bg-slate-50 dark:bg-slate-900/50 border-2 border-dashed border-slate-200 dark:border-slate-800 rounded-3xl p-6 h-64 flex flex-col items-center justify-center">
                      <span class="text-[8px] font-black text-slate-400 uppercase tracking-widest">
                        Publicidad
                      </span>
                      <div class="text-xs text-slate-500 italic">
                        In-Feed Ad
                      </div>
                    </div>
                  )}
                </>
              ))
            }
          </div>
        </section>
      </div>

      <aside class="hidden lg:block lg:w-1/4">
        <div class="sticky top-24 flex flex-col h-[calc(100vh-140px)]">
          <div
            class="grow bg-slate-50 dark:bg-slate-900/50 border-2 border-dashed border-slate-200 dark:border-slate-800 rounded-[40px] flex flex-col items-center justify-center p-6 text-center"
          >
            <span
              class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-4"
              >Anuncio Lateral</span
            >
            <p class="text-[10px] text-slate-500 leading-relaxed italic">
              Este espacio está optimizado para anuncios verticales de AdSense.
            </p>
          </div>

          <div
            class="mt-8 p-6 bg-blue-600 rounded-[30px] text-white shadow-xl shadow-blue-500/20"
          >
            <h4 class="font-black uppercase tracking-tighter text-xl">
              ¿Te gusta BrayNews?
            </h4>
            <p class="text-blue-100 text-[10px] mt-2 font-medium leading-tight">
              Compártelo con tus amigos en Montería y Córdoba.
            </p>
          </div>
        </div>
      </aside>
    </div>

    <div class="mt-16 text-center pb-20">
      <Button
        href="/categoria/general"
        variant="outline"
        class="w-full md:w-auto">Cargar más actualidad</Button
      >
    </div>
  </main>
</Layout>
